{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.local/bin/herdr-codex-meta", "timeout": 3 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.local/bin/herdr-codex-meta", "timeout": 3 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.local/bin/herdr-codex-meta", "timeout": 3 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.local/bin/herdr-codex-meta", "timeout": 3 }] }
    ],
    "Interrupt": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.local/bin/herdr-codex-meta", "timeout": 3 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "python3 ~/.local/bin/herdr-codex-meta", "timeout": 3 }] }
    ]
  }
}
